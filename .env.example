
POSTGRES_DB=ort_sentinel
POSTGRES_USER=ort
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Local development defaults to SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./ort_sentinel_fallback.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
WASTE_THRESHOLD_GRAMS=100
MONEY_PER_KG=50
CO2_PER_KG=2.5
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SEED_DEMO_DATA=true

MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=ort-sentinel/waste/events
